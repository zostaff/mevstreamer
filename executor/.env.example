RPC_URL=https://api.mainnet-beta.solana.com
# base58 64-byte secret key. Optional when DRY_RUN=true (ephemeral key; dry runs simulate as SIM_PAYER).
WALLET_PRIVATE_KEY=
BUY_SOL=0.05
RELAYS=sender,jito
JITO_TIP=auto
JITO_TIP_MAX=0.001
SENDER_TIP=0.000005
PRIORITY_FEE=auto
TAKE_PROFIT=2.0
STOP_LOSS=0.5
TIMEOUT_SEC=120
MAX_POSITIONS=3
SLIPPAGE_PCT=5
DRY_RUN=true
# Optional overrides
# JITO_URLS=https://ny.mainnet.block-engine.jito.wtf,https://frankfurt.mainnet.block-engine.jito.wtf
# HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
# CU_LIMIT_BUY=90000
# CU_LIMIT_SELL=60000
# SOCKET_PATH=/tmp/mev-streamer.sock
