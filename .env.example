# Solana
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# base58, 64-byte secret key. Leave empty for DRY_RUN (executor uses an ephemeral key);
# a non-base58 placeholder makes the executor exit even in DRY_RUN.
WALLET_PRIVATE_KEY=

# Stream
STREAM_URL=https://twitch.tv/streamer_name
STREAM_FPS=3
STREAM_AUDIO_CHUNK_SEC=3

# Vision
# auto = Apple Vision on macOS (~0.1 s/frame), else EasyOCR (GPU recommended)
OCR_ENGINE=auto
OCR_GPU=true
UI_DETECTION=true

# Audio
# base.en on CPU (~0.4 s per 3 s chunk on M1); small.en is fine on CUDA
WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda

# Signal
SIGNAL_THRESHOLD=0.7
SIGNAL_COOLDOWN_SEC=60

# Execution
BUY_SOL=0.1
# Landing: one signed tx is fanned out to every relay in RELAYS (same signature → lands once)
RELAYS=sender,jito                # sender (Helius Sender) | jito | rpc
JITO_TIP=auto                     # auto = live tip_floor p75, capped by JITO_TIP_MAX; or SOL amount
JITO_TIP_MAX=0.001
SENDER_TIP=0.000005               # >= 0.001 → Sender Max (all paths); lower → ?swqos_only=true tier
PRIORITY_FEE=auto                 # auto = p75 of recent fees on the bonding curve; or µ-lamports/CU
TAKE_PROFIT=2.0
STOP_LOSS=0.5
TIMEOUT_SEC=120
MAX_POSITIONS=3
SLIPPAGE_PCT=5

# Mode
DRY_RUN=true

# --- Optional (defaults shown) ---
# HELIUS_API_KEY=            # $TICKER → mint resolver; taken from a helius RPC_URL if unset
# STREAM_RESOLUTION=1280:720
# OCR_MIN_CONFIDENCE=0.4
# VISION_ROI_MODE=auto       # auto (full for applevision, roi otherwise) | roi | full
# VISION_MINT_REPAIR=true    # fix OCR-corrupted pump mints, verified on-chain via RPC_URL
# WHISPER_COMPUTE_TYPE=      # auto: float16 on cuda, int8 on cpu
# AUDIO_VAD_RMS=0.01
# AUDIO_SILERO_VAD=true
# JITO_URLS=https://ny.mainnet.block-engine.jito.wtf,https://frankfurt.mainnet.block-engine.jito.wtf
# HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast   # regional: http://ewr-sender.helius-rpc.com/fast
# PRIORITY_FEE_MIN=50000
# PRIORITY_FEE_MAX=3000000
# CU_LIMIT_BUY=90000                # measured 70–74k on mainnet (executor --selfcheck)
# CU_LIMIT_SELL=60000               # measured 46k
# SIM_PAYER=                        # funded wallet to simulate as in DRY_RUN without a key
# LOG_LEVEL=INFO
# IPC socket: Python reads IPC_SOCKET_PATH, the executor reads SOCKET_PATH.
# scripts/*.sh set both from whichever is defined; set both if launching by hand.
# IPC_SOCKET_PATH=/tmp/mev-streamer.sock
# SOCKET_PATH=/tmp/mev-streamer.sock
